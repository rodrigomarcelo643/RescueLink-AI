# Supabase Edge Function Secrets
# Set these via: supabase secrets set KEY=value
# Or via Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# WARNING: Never put these in frontend .env files.
# The VITE_ prefix exposes values to the browser — none of these should have it.

# Supabase (service role — backend only)
SUPABASE_SERVICE_ROLE_KEY=<service_role>

# OpenAI
OPENAI_API_KEY=sk-<key>

# Google Maps (server-side geocoding in ai-extract)
GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# Facebook Messenger
FB_PAGE_ACCESS_TOKEN=<page-access-token>
FB_VERIFY_TOKEN=<any-random-string>
FB_PAGE_ID=<page-id>

# Telegram
TELEGRAM_BOT_TOKEN=<bot-token>

# WhatsApp Business API
WHATSAPP_TOKEN=<access-token>
WHATSAPP_PHONE_NUMBER_ID=<phone-number-id>
WHATSAPP_VERIFY_TOKEN=<any-random-string>

# PayMongo
PAYMONGO_SECRET_KEY=sk_<key>
PAYMONGO_PUBLIC_KEY=pk_<key>

# SMS — Semaphore
SMS_API_KEY=<semaphore-api-key>
SMS_SENDER_NAME=RescueLinkAI

# Email — Resend
RESEND_API_KEY=re_<key>
MAIL_FROM=noreply@rescuelinkai.ph
